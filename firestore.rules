rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Orders: Anyone can create a new booking order, authenticated admins can read/update/delete
    match /orders/{orderId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0;
      allow read, update, delete: if isSignedIn();
    }

    // Blog posts: Public read access, authenticated write access
    match /blog/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // FAQs: Public read access, authenticated write access
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Testimonials: Public read access, authenticated write access
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Company Settings: Public read access, authenticated write access
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Services: Public read access, authenticated write access
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
